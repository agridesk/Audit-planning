# Fail-closed clasp upload allowlist: root-level GAS sources and manifest only.
# Subdirectory sources and repository artifacts must never enter Apps Script.
**/*
!*.js
!*.gs
!*.html
!appsscript.json

# Explicit repository exclusions (also exclude matching source extensions).
.git/**
.github/**
cloudrun/**
docs/**
scripts/**
tests/**
node_modules/**
