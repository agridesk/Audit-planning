@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import vm from 'node:vm';
+
+const r4=readFileSync(new URL('./server-r4.js',import.meta.url),'utf8');
+const loop=r4.match(/for\(const b of requested\)\{\s*let x=avRows\.find[^]*?touched\.set\(x\.sheetRow,x\);\s*\}/)[0];
+assert.match(loop,/AVAILABILITY_HARD_BLOCK_/);
+
+const clean=v=>String(v??'').trim();
+const yes=v=>['yes','true','1','y','ja'].includes(clean(v).toLowerCase());
+const overlaps=(a,b)=>!!(a.start&&a.end&&b.start&&b.end&&a.start<b.end&&b.start<a.end);
+// Columns: Date, Email, Available, s1,e1,id1, s2,e2,id2, st1, st2
+const header=['Date','Auditor_Email','Available','S1','E1','ID1','S2','E2','ID2','ST1','ST2'];
+function run({row,flags,authorityPreflight,block={date:'2027-01-04',start:'09:00',end:'17:00'}}){
+ const av=[header,row.slice()],avRows=[{row:row.slice(),sheetRow:2,date:row[0],email:row[1]}],touched=new Map();
+ const ctx={requested:[block],avRows,av,ah:header,cd:0,ce:1,ca:2,s1:3,e1:4,id1:5,s2:6,e2:7,id2:8,st1:9,st2:10,lu:-1,
+  auditorEmail:'a@example.test',auditId:'NEW-1',actorRole:'MANAGER',authorityPreflight,touched,clean,yes,overlaps,
+  isoLocalStamp:()=>'2027-01-01 00:00',process:{env:flags}};
+ vm.runInNewContext(loop,ctx);
+ return [...touched.values()][0].row;
+}
+const atomic={AMS_RUNTIME_ENV:'DEV',AMS_DEV_FIRESTORE_ATOMIC_PLANNING_ENABLED:'true'};
+const authority={...atomic,AMS_DEV_FIRESTORE_AVAILABILITY_AUTHORITY_ENABLED:'true'};
+const hardDay=['2027-01-04','a@example.test','NO','','','','','','','Unavailable',''];
+
+// Legacy behaviour is unchanged without the authority flag or outside the atomic preflight.
+assert.throws(()=>run({row:hardDay,flags:atomic,authorityPreflight:true}),/AVAILABILITY_HARD_BLOCK_2027-01-04/);
+assert.throws(()=>run({row:hardDay,flags:authority,authorityPreflight:false}),/AVAILABILITY_HARD_BLOCK_2027-01-04/);
+assert.throws(()=>run({row:hardDay,flags:{...authority,AMS_DEV_FIRESTORE_ATOMIC_PLANNING_ENABLED:'false'},authorityPreflight:true}),/AVAILABILITY_HARD_BLOCK_/);
+
+// With Firestore authority the stale Sheets HARD projection no longer blocks; the empty slot is used.
+const projected=run({row:hardDay,flags:authority,authorityPreflight:true});
+assert.deepEqual(projected.slice(3,11),['','','','09:00','17:00','NEW-1','Unavailable','Manager Planned']);
+assert.equal(projected[2],'NO');
+
+// Audit-vs-audit collisions and capacity still fail closed.
+const occupied=['2027-01-04','a@example.test','NO','10:00','12:00','OTHER','','','','Manager Planned',''];
+assert.throws(()=>run({row:occupied,flags:authority,authorityPreflight:true}),/AVAILABILITY_COLLISION_2027-01-04/);
+const full=['2027-01-04','a@example.test','NO','07:00','08:00','X1','18:00','19:00','X2','Manager Planned','Manager Planned'];
+assert.throws(()=>run({row:full,flags:authority,authorityPreflight:true}),/AVAILABILITY_CAPACITY_2027-01-04/);
+
+// The planner workspace route is replaced only on DEV with the explicit flag.
+const r15=readFileSync(new URL('./server-r15.js',import.meta.url),'utf8');
+assert.match(r15,/const firestorePlannerAvailabilityEnabled=runtime\.isDev&&process\.env\.AMS_DEV_FIRESTORE_AVAILABILITY_AUTHORITY_ENABLED==='true';/);
+assert.match(r15,/if\(req\.method==='GET'&&u\.pathname==='\/api\/v1\/planning\/workspace'&&firestorePlannerAvailabilityEnabled\)\{await firestorePlannerWorkspace\(req,res\);return;\}/);
+assert.match(r15,/applyFirestorePlannerAvailability\(\{workspace:body,actor:\{role:actor\.role,id:actor\.auditorId\},roster:await swapRoster\(\),period:overlay\.period\}\)/);
+console.log('availability firestore authority preflight tests passed');
diff --git a/cloudrun/transport-proof/availability-planner-calendar-projection-20-test.mjs b/cloudrun/transport-proof/availability-planner-calendar-projection-20-test.mjs
new file mode 100644
index 0000000..c608c37
--- /dev/null
+++ b/cloudrun/transport-proof/availability-planner-calendar-projection-20-test.mjs
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict';
+import {plannerRowsFromPeriod,splitAvailabilityRange,applyFirestorePlannerAvailability} from './availability-planner-calendar-projection-20.js';
+import {resolveAvailabilityPeriod} from './availability-resolver-20.js';
+
+// Ranges are bounded to the overlay service read limit (<=92 day difference).
+assert.deepEqual(splitAvailabilityRange('2027-01-01','2027-01-05'),[{fromDate:'2027-01-01',toDate:'2027-01-05'}]);
+const long=splitAvailabilityRange('2027-01-01','2027-12-31');
+assert.ok(long.length>1);
+assert.equal(long[0].fromDate,'2027-01-01');assert.equal(long.at(-1).toDate,'2027-12-31');
+for(let i=1;i<long.length;i++)assert.equal(Date.parse(long[i].fromDate)-Date.parse(long[i-1].toDate),86400000);
+for(const r of long)assert.ok((Date.parse(r.toDate)-Date.parse(r.fromDate))/86400000<=92);
+assert.deepEqual(splitAvailabilityRange('2027-02-01','2027-01-01'),[]);
+assert.throws(()=>splitAvailabilityRange('x','2027-01-01'),/RANGE_INVALID/);
+
+// 2027-01-04 Mon: whole-day HARD (the reported false block came from Sheets; Firestore is now leading).
+// 2027-01-05 Tue: partial HARD. 2027-01-06 Wed: committed audit. 2027-01-07 Thu: free. 2027-01-09 Sat: weekend SOFT.
+const days=resolveAvailabilityPeriod({fromDate:'2027-01-04',toDate:'2027-01-09',blocks:[
+ {id:'h1',date:'2027-01-04',wholeDay:true,state:'HARD'},
+ {id:'h2',date:'2027-01-05',wholeDay:false,start:'13:00',end:'17:00',state:'HARD'},
+ {id:'audit:A-1|2027-01-06|09:00|17:00',date:'2027-01-06',wholeDay:false,start:'09:00',end:'17:00',state:'COMMITTED'}
+]});
+const rows=plannerRowsFromPeriod({email:'Auditor@Example.test',days,auditDetails:{
+ 'audit:A-1|2027-01-06|09:00|17:00':{auditId:'A-1',company:'Co',scopes:'Scope A, Scope B',date:'2027-01-06',start:'09:00',end:'17:00',state:'COMMITTED'}
+}});
+const by=Object.fromEntries(rows.map(r=>[r.date,r]));
+assert.equal(by['2027-01-04'].visualState,'HARD_BLOCKED');
+assert.deepEqual(by['2027-01-04'].slots.map(s=>[s.kind,s.start,s.end]),[['hard','','']]);
+assert.equal(by['2027-01-05'].visualState,'HARD_BLOCKED');
+assert.deepEqual(by['2027-01-05'].slots.map(s=>[s.kind,s.start,s.end]),[['hard','13:00','17:00']]);
+assert.equal(by['2027-01-06'].visualState,'OCCUPIED');
+assert.deepEqual(by['2027-01-06'].slots[0],{start:'09:00',end:'17:00',auditId:'A-1',auditRef:'A-1',status:'Committed',kind:'audit',company:'Co',scopes:['Scope A','Scope B']});
+assert.equal(by['2027-01-07'],undefined,'free weekdays use the client default AVAILABLE row');
+assert.equal(by['2027-01-09'].visualState,'SOFT_UNAVAILABLE');
+assert.ok(rows.every(r=>r.auditorEmail==='auditor@example.test'));
+assert.throws(()=>plannerRowsFromPeriod({email:'',days,auditDetails:{}}),/SOURCE_INVALID/);
+
+// Workspace overlay: managers read every candidate by UID; Sheets rows are fully replaced.
+const roster=[{auditorId:'uid-1',email:'a@example.test'},{auditorId:'uid-2',email:'b@example.test'},{auditorId:'manager:x',email:'m@example.test'}];
+const calls=[];
+const period=async args=>{calls.push(args);return {auditorId:args.auditorId,days:resolveAvailabilityPeriod({fromDate:args.fromDate,toDate:args.toDate,blocks:args.auditorId==='uid-1'?[{id:'h',date:'2027-01-04',wholeDay:true,state:'HARD'}]:[]}),auditDetails:{}};};
+const workspace={ok:true,data:{period:{from:'2027-01-04',to:'2027-01-08'},audit:{candidateAuditors:[{email:'A@example.test'},{email:'b@example.test'},{email:'unknown@example.test'}]},overlays:{availability:{byAuditorEmail:{'a@example.test':[{date:'2027-01-05',visualState:'HARD_BLOCKED',slots:[{kind:'hard'}]}]}},reservations:{rows:[]}}}};
+const out=await applyFirestorePlannerAvailability({workspace,actor:{role:'manager',id:'manager:x'},roster,period});
+assert.equal(out.data.overlays.availability.source,'FIRESTORE_AVAILABILITY_20');
+assert.equal(out.data.overlays.availability.unresolvedCandidates,1);
+assert.deepEqual(out.data.overlays.availability.byAuditorEmail['a@example.test'].map(r=>[r.date,r.visualState]),[['2027-01-04','HARD_BLOCKED']]);
+assert.deepEqual(out.data.overlays.availability.byAuditorEmail['b@example.test'],[]);
+assert.deepEqual(out.data.overlays.reservations,{rows:[]});
+assert.deepEqual(calls.map(c=>c.auditorId).sort(),['uid-1','uid-2']);
+assert.ok(calls.every(c=>c.actor.role==='manager'&&c.actor.id==='manager:x'&&c.canonicalAuditors.length===2));
+assert.equal(workspace.data.overlays.availability.byAuditorEmail['a@example.test'][0].date,'2027-01-05','input is not mutated');
+
+// Auditors may only read their own UID; failures are fail-closed.
+const own={ok:true,data:{period:{from:'2027-01-04',to:'2027-01-04'},audit:{candidateAuditors:[{email:'a@example.test'}]},overlays:{availability:{byAuditorEmail:{}}}}};
+const self=await applyFirestorePlannerAvailability({workspace:own,actor:{role:'auditor',id:'uid-1'},roster,period});
+assert.equal(self.data.overlays.availability.byAuditorEmail['a@example.test'][0].visualState,'HARD_BLOCKED');
+assert.ok(!('canonicalAuditors' in calls.at(-1)));
+await assert.rejects(applyFirestorePlannerAvailability({workspace:own,actor:{role:'auditor',id:'uid-2'},roster,period}),/SCOPE_FORBIDDEN/);
+await assert.rejects(applyFirestorePlannerAvailability({workspace,actor:{role:'manager',id:'manager:x'},roster,period:async()=>{throw Error('FIRESTORE_DOWN');}}),/FIRESTORE_DOWN/);
+await assert.rejects(applyFirestorePlannerAvailability({workspace,actor:{role:'manager',id:'manager:x'},roster,period:async a=>({auditorId:'other',days:[],auditDetails:{}})}),/SOURCE_INVALID/);
+// Non-workspace or failed responses pass through unchanged.
+const failed={ok:false,error:'AUDIT_NOT_FOUND'};
+assert.equal(await applyFirestorePlannerAvailability({workspace:failed,actor:{role:'manager',id:'m'},roster,period}),failed);
+console.log('availability-planner-calendar-projection-20 tests passed');
diff --git a/cloudrun/transport-proof/availability-planner-calendar-projection-20.js b/cloudrun/transport-proof/availability-planner-calendar-projection-20.js
new file mode 100644
index 0000000..b516094
--- /dev/null
+++ b/cloudrun/transport-proof/availability-planner-calendar-projection-20.js
@@ -0,0 +1,80 @@
+/** AMS Availability 2.0: planner-calendar projection from Firestore (DEV authority).
+ * Replaces the legacy Sheets 'Auditor Availability' overlay in the planning workspace
+ * with rows resolved from the canonical Firestore availability document (Auditor_UID).
+ * Read-only. Fails closed: any read error rejects the whole projection.
+ */
+const MAX_RANGE_DAYS=92;
+const clean=x=>String(x??'').trim();
+const isDate=s=>typeof s==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(s)&&new Date(s+'T00:00:00Z').toISOString().slice(0,10)===s;
+const addDays=(s,n)=>new Date(Date.parse(s+'T00:00:00Z')+n*86400000).toISOString().slice(0,10);
+const scopeList=v=>Array.isArray(v)?v.map(clean).filter(Boolean):clean(v).split(/\s*,\s*/).filter(Boolean);
+
+export function splitAvailabilityRange(fromDate,toDate,maxDays=MAX_RANGE_DAYS){
+ if(!isDate(fromDate)||!isDate(toDate))throw Error('PLANNER_AVAILABILITY_RANGE_INVALID');
+ if(toDate<fromDate)return [];
+ const out=[];let start=fromDate;
+ while(start<=toDate){const end=addDays(start,maxDays)<toDate?addDays(start,maxDays):toDate;out.push({fromDate:start,toDate:end});start=addDays(end,1);}
+ return out;
+}
+
+/** Map one resolved Firestore period to the legacy planner row format. */
+export function plannerRowsFromPeriod({email,days,auditDetails}={}){
+ const auditorEmail=clean(email).toLowerCase();
+ if(!auditorEmail||!Array.isArray(days)||!auditDetails||typeof auditDetails!=='object')throw Error('PLANNER_AVAILABILITY_SOURCE_INVALID');
+ const auditsByDate={};
+ for(const d of Object.values(auditDetails)){
+  if(!d||!isDate(d.date)||!clean(d.auditId))throw Error('PLANNER_AVAILABILITY_SOURCE_INVALID');
+  (auditsByDate[d.date]??=[]).push(d);
+ }
+ const rows=[];
+ for(const day of days){
+  if(!day||!isDate(day.date)||!Array.isArray(day.segments))throw Error('PLANNER_AVAILABILITY_SOURCE_INVALID');
+  const slots=[];
+  for(const a of (auditsByDate[day.date]||[]).sort((x,y)=>clean(x.start).localeCompare(clean(y.start)))){
+   const auditId=clean(a.auditId);
+   slots.push({start:clean(a.start),end:clean(a.end),auditId,auditRef:auditId,status:a.state==='PROVISIONAL'?'Provisional':'Committed',kind:'audit',company:clean(a.company),scopes:scopeList(a.scopes)});
+  }
+  let hard=false,soft=false;
+  for(const s of day.segments){
+   if(s.state!=='HARD'&&s.state!=='SOFT')continue;
+   const wholeDay=s.start==='00:00'&&s.end==='24:00';
+   if(s.state==='HARD')hard=true;else soft=true;
+   slots.push({start:wholeDay?'':clean(s.start),end:wholeDay?'':clean(s.end),auditId:'',auditRef:'',status:s.state==='HARD'?'Unavailable':'SYSTEM_DEFAULT',kind:s.state==='HARD'?'hard':'soft',company:'',scopes:[]});
+  }
+  if(!slots.length)continue;
+  const occupied=slots.some(z=>z.kind==='audit');
+  rows.push({date:day.date,auditorEmail,available:occupied||hard||soft?'NO':'YES',state:occupied||hard||soft?'NO':'YES',
+   visualState:occupied?'OCCUPIED':hard?'HARD_BLOCKED':soft?'SOFT_UNAVAILABLE':'AVAILABLE',slots,source:'FIRESTORE_AVAILABILITY_20'});
+ }
+ return rows;
+}
+
+/** Replace data.overlays.availability in a planning-workspace response with Firestore rows.
+ * period: async ({actor,auditorId,fromDate,toDate,canonicalAuditors}) => overlay.period result.
+ * roster: [{auditorId,email}] canonical active identities.
+ */
+export async function applyFirestorePlannerAvailability({workspace,actor,roster,period}={}){
+ if(typeof period!=='function'||!Array.isArray(roster))throw Error('PLANNER_AVAILABILITY_CONFIGURATION_INVALID');
+ const data=workspace?.data;
+ if(workspace?.ok!==true||!data?.overlays?.availability||!data.period)return workspace;
+ if(!actor||!clean(actor.id)||!['manager','auditor'].includes(actor.role))throw Error('PLANNER_AVAILABILITY_ACTOR_INVALID');
+ const {from,to}=data.period;
+ const ranges=isDate(from)&&isDate(to)?splitAvailabilityRange(from,to):[];
+ const canonicalAuditors=roster.filter(x=>clean(x.auditorId)&&!clean(x.auditorId).startsWith('manager:')).map(x=>({auditorId:clean(x.auditorId),email:clean(x.email).toLowerCase()}));
+ const byEmail=new Map(canonicalAuditors.map(x=>[x.email,x.auditorId]));
+ const emails=[...new Set((data.audit?.candidateAuditors||[]).map(x=>clean(x?.email).toLowerCase()).filter(Boolean))];
+ const byAuditorEmail={};let unresolved=0;
+ await Promise.all(emails.map(async email=>{
+  const auditorId=byEmail.get(email);
+  if(!auditorId){unresolved++;byAuditorEmail[email]=[];return;}
+  if(actor.role==='auditor'&&auditorId!==clean(actor.id))throw Error('PLANNER_AVAILABILITY_SCOPE_FORBIDDEN');
+  const rows=[];
+  for(const r of ranges){
+   const result=await period({actor:{role:actor.role,id:clean(actor.id)},auditorId,fromDate:r.fromDate,toDate:r.toDate,...(actor.role==='manager'?{canonicalAuditors}:{})});
+   if(!result||result.auditorId!==auditorId)throw Error('PLANNER_AVAILABILITY_SOURCE_INVALID');
+   rows.push(...plannerRowsFromPeriod({email,days:result.days,auditDetails:result.auditDetails||{}}));
+  }
+  byAuditorEmail[email]=rows;
+ }));
+ return {...workspace,data:{...data,overlays:{...data.overlays,availability:{byAuditorEmail,source:'FIRESTORE_AVAILABILITY_20',unresolvedCandidates:unresolved}}}};
+}
