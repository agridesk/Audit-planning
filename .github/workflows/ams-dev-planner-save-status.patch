diff --git a/cloudrun/transport-proof/planning-save-status-visible-20-test.mjs b/cloudrun/transport-proof/planning-save-status-visible-20-test.mjs
new file mode 100644
index 0000000..9d3af0b
--- /dev/null
+++ b/cloudrun/transport-proof/planning-save-status-visible-20-test.mjs
@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import vm from 'node:vm';
+
+const source=readFileSync(new URL('./server-r5.js',import.meta.url),'utf8');
+const sticky=source.match(/<div class="actions actionsSticky">[\s\S]*?<\/div>/)[0];
+assert.match(sticky,/<span id="saveStatus" class="saveStatus" role="status" aria-live="polite"><\/span>/,'save status sits next to the sticky Save button');
+assert(sticky.indexOf('id="saveStatus"')<sticky.indexOf('id="save"'),'status precedes Save button');
+assert.match(source,/\.saveStatus\.err\{color:#b91c1c\}/);
+
+const fn=source.match(/function setStatus\(msg,cls\)\{[^]*?\}\}/)[0];
+const els={'#status':{textContent:'',className:''},'#saveStatus':{textContent:'',className:''}};
+const ctx={q:s=>els[s]};
+vm.runInNewContext(fn+';setStatus("PLANNING_WINDOW_BLOCKED","err")',ctx);
+assert.equal(els['#status'].textContent,'PLANNING_WINDOW_BLOCKED');
+assert.equal(els['#saveStatus'].textContent,'PLANNING_WINDOW_BLOCKED');
+assert.equal(els['#saveStatus'].className,'saveStatus err');
+delete els['#saveStatus'];
+vm.runInNewContext(fn+';setStatus("Saved","ok")',ctx);
+assert.equal(els['#status'].className,'status ok','works without inline element');
+console.log('planning save status visible test passed');
