+   const u=new URL(base+'/'+collection);u.searchParams.set('pageSize','300');
+   if(pageToken)u.searchParams.set('pageToken',pageToken);
+   const r=await request(u.toString());
+   if(!r.ok)throw Error('REALIZED_FIRESTORE_LIST_'+r.status);
+   const data=await r.json();
+   for(const raw of data.documents||[]){
+    const id=decodeURIComponent(String(raw.name||'').split('/').at(-1)||'');
+    if(!raw.fields?.payload)throw Error('REALIZED_FIRESTORE_CORRUPT');
+    const value=decode(raw.fields.payload);
+    if(value?.auditId!==id||value?.schema!==REALIZED_AUDIT_SCHEMA_20)throw Error('REALIZED_FIRESTORE_CORRUPT');
+    documents.push(value);
+   }
+   if(documents.length>maxDocuments)throw Error('REALIZED_FIRESTORE_TOO_MANY_DOCUMENTS');
+   pageToken=data.nextPageToken||'';
+  }while(pageToken);
+  return documents;
+ }
+ async function listAll(){
+  if(cache&&Date.now()-cache.at<cacheMs)return structuredClone(cache.documents);
+  if(!inflight)inflight=load().then(documents=>{cache={at:Date.now(),documents};return documents;}).finally(()=>{inflight=null;});
+  return structuredClone(await inflight);
+ }
+ /** Create-only batch (exists:false). Callers must hold explicit data-write approval. */
+ async function createMany(documents){
+  if(!Array.isArray(documents)||documents.length>400)throw Error('REALIZED_FIRESTORE_BATCH_INVALID');
+  for(const d of documents)if(d?.schema!==REALIZED_AUDIT_SCHEMA_20||!validId(d.auditId))throw Error('REALIZED_FIRESTORE_DOCUMENT_INVALID');
+  if(!documents.length)return {created:0};
+  const writes=documents.map(d=>({update:{name:root+'/'+collection+'/'+encodeURIComponent(d.auditId),fields:{payload:encode(d)}},currentDocument:{exists:false}}));
+  const r=await request(base+':commit','POST',{writes});
+  if([409,412].includes(r.status))throw Error('REALIZED_FIRESTORE_ALREADY_EXISTS');
+  if(!r.ok)throw Error('REALIZED_FIRESTORE_COMMIT_'+r.status);
+  cache=null;
+  return {created:documents.length};
+ }
+ return Object.freeze({listAll,createMany,collection});
+}
