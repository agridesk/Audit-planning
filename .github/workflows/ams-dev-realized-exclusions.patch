+function encode(v){
+ if(v===null)return {nullValue:null};
+ if(typeof v==='string')return {stringValue:v};
+ if(typeof v==='boolean')return {booleanValue:v};
+ if(typeof v==='number'&&Number.isSafeInteger(v))return {integerValue:String(v)};
+ if(typeof v==='number'&&Number.isFinite(v))return {doubleValue:v};
+ if(Array.isArray(v))return {arrayValue:{values:v.map(encode)}};
+ if(v&&typeof v==='object')return {mapValue:{fields:Object.fromEntries(Object.entries(v).filter(([,x])=>x!==undefined).map(([k,x])=>[k,encode(x)]))}};
+ throw Error('REALIZED_FIRESTORE_INVALID_VALUE');
+}
+
+/** REST store. Documents use the same {payload} envelope as the planning store. */
+export function createRealizedAuditsFirestoreStore20({projectId,getToken,fetchImpl=fetch,databaseId='(default)',collection=REALIZED_AUDITS_COLLECTION_20,cacheMs=2000,maxDocuments=6000}={}){
+ if(!/^[a-z][a-z0-9-]{4,62}$/.test(projectId||'')||typeof getToken!=='function'||!/^[A-Za-z0-9_]+$/.test(collection))throw Error('REALIZED_FIRESTORE_CONFIG_INVALID');
+ const root='projects/'+projectId+'/databases/'+databaseId+'/documents';
+ const base='https://firestore.googleapis.com/v1/'+root.replace(databaseId,encodeURIComponent(databaseId));
+ let cache=null,inflight=null;
+ async function request(url,method='GET',body){
+  const token=await getToken();if(!token)throw Error('REALIZED_FIRESTORE_TOKEN_REQUIRED');
