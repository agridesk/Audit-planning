+}
+
+/** Realized document for a new completion, built from the lifecycle log row. */
+export function realizedDocumentForCompletion20({headers,row,auditorUid,operationId,completedByUid=null}){
+ const index={hasUid:uid=>clean(uid)===clean(auditorUid),uidForEmail:()=>clean(auditorUid)};
+ if(!validId(clean(auditorUid)))throw Error('REALIZED_COMPLETION_AUDITOR_UID_REQUIRED');
