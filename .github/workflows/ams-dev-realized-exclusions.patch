+   ...SCOPE_SLOTS.map(s=>slots.has(s)?'x':''),num(d.hoursPlanned),num(d.hoursDedicated),num(d.hoursToBePlanned),clean(d.scopesList),clean(d.completedByEmail),
+   ...extraNames.map(n=>d.extra?.[n]??'')];
+ });
