+/** DEV-only Firestore authority for realized (completed) audits.
+ * Firestore stores one document per Audit ID keyed by Auditor_UID; the
+ * "Log realized audits" tab is only a derived projection. The Auditor e-mail
+ * column is derived at read time from the current Auditors roster via UID.
+ */
+import {createHash} from 'node:crypto';
+import {buildAuditorIdentityIndex,resolveAuditorUid} from './auditor-identity-versions.js';
+
+export const REALIZED_AUDITS_COLLECTION_20='ams_realized_audits_20_dev';
+export const REALIZED_AUDIT_SCHEMA_20='AMS_REALIZED_AUDIT_V1';
+const SCOPE_SLOTS=Array.from({length:8},(_,i)=>'SCOPE_'+String(i+1).padStart(2,'0'));
+const clean=v=>String(v??'').trim();
+const key=v=>clean(v).toLowerCase().replace(/[\s_-]+/g,'_');
+const validId=x=>typeof x==='string'&&x.length>0&&x.length<=180&&!/[\\/]/.test(x)&&x!=='.'&&x!=='..';
+const yes=v=>v===true||['x','yes','true','1','ja'].includes(clean(v).toLowerCase());
+
+export function realizedAuditsAuthorityEnabled20(env=process.env){
+ return env.AMS_RUNTIME_ENV==='DEV'&&env.AMS_DEV_FIRESTORE_REALIZED_AUDITS_AUTHORITY_ENABLED==='true';
+}
+
+const FIELDS={
+ auditId:['Audit ID','Audit_ID','AuditId','Audit Id'],
+ status:['Status'],
+ auditorEmail:['Auditor','Auditor Email','Auditor_Email','Email','E-mail'],
+ auditorUid:['Auditor_UID','Auditor UID'],
+ company:['Company'],
+ companyUid:['Company_UID','Company UID','CompanyUid'],
+ location:['Location'],
+ year:['Year'],
+ datePlanned:['Date planned','Date - Planned'],
+ dateApproved:['Date approved','Date - Approved'],
+ dateAccepted:['Date accepted','Date - Accepted'],
+ dateCompleted:['Date completed','Completed date'],
+ hoursPlanned:['Hours planned'],
+ hoursDedicated:['Hours dedicated'],
+ hoursToBePlanned:['Hours to be planned'],
+ scopesList:['Scopes list'],
+ completedByEmail:['Manager_Email','Manager email','Manager e-mail']
+};
+function indexHeaders(headers){
+ const byKey=new Map();
+ headers.forEach((h,i)=>{const k=key(h);if(k&&!byKey.has(k))byKey.set(k,i);});
+ const at=names=>{for(const n of names){const i=byKey.get(key(n));if(i!==undefined)return i;}return -1;};
+ const mapped=new Set(),cols={};
+ for(const [field,names] of Object.entries(FIELDS)){
+  cols[field]=at(names);
+  for(const n of names){const i=byKey.get(key(n));if(i!==undefined)mapped.add(i);}
+ }
+ const scopes=SCOPE_SLOTS.map(slot=>({slot,i:at([slot])}));
+ scopes.forEach(s=>{if(s.i>=0)mapped.add(s.i);});
+ return {cols,scopes,mapped};
+}
+function isoDate(v){
+ if(typeof v==='number'&&Number.isFinite(v)&&v>20000&&v<80000)
+  return new Date(Date.UTC(1899,11,30)+Math.round(v)*86400000).toISOString().slice(0,10);
+ const s=clean(v);if(!s)return '';
+ let m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return m[1]+'-'+m[2]+'-'+m[3];
+ m=s.match(/^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})$/);
+ if(m)return m[3]+'-'+m[2].padStart(2,'0')+'-'+m[1].padStart(2,'0');
+ return s;
+}
+function hours(v){
+ if(v===''||v===null||v===undefined)return null;
+ const n=typeof v==='number'?v:Number(clean(v).replace(',','.'));
+ return Number.isFinite(n)?n:null;
+}
+
+/** Index of the Auditors roster: e-mail (current or historical) -> UID. */
+export function realizedAuditorIndex20(auditorValues,identityVersions=null){
+ const values=Array.isArray(auditorValues)?auditorValues:[];
+ const h=values[0]||[];
+ const find=names=>{for(const n of names){const i=h.findIndex(x=>key(x)===key(n));if(i>=0)return i;}return -1;};
+ const ue=find(['E-mail','Email']),uu=find(['Auditor_UID','Auditor UID']);
+ if(ue<0||uu<0)throw Error('REALIZED_AUDITORS_SCHEMA_INVALID');
+ const emailByUid=new Map(),uidByEmail=new Map(),rows=[];
+ for(const r of values.slice(1)){
+  const email=clean(r[ue]).toLowerCase(),uid=clean(r[uu]);
+  if(!uid)continue;
+  if(emailByUid.has(uid))throw Error('REALIZED_AUDITORS_DUPLICATE_UID');
+  emailByUid.set(uid,email);
+  if(email){uidByEmail.set(email,uid);rows.push({uid,email});}
+ }
+ // Identity versions only add historical aliases; an inconsistent version tab
+ // must not block the current-roster mapping, so the error is reported instead.
+ let versionIndex=null,versionsStatus='NONE';
+ if(identityVersions){try{versionIndex=buildAuditorIdentityIndex(rows,identityVersions);versionsStatus='USED';}catch(e){versionsStatus='UNUSABLE_'+String(e?.message||'ERROR').replace(/[^A-Z0-9_]/g,'').slice(0,60);}}
+ return {
+  versionsStatus,
+  emailForUid:uid=>emailByUid.get(clean(uid))||'',
+  hasUid:uid=>emailByUid.has(clean(uid)),
+  uidForEmail:(email,at=null)=>{
+   const e=clean(email).toLowerCase();if(!e)return '';
+   if(versionIndex){
+    const day=clean(at).slice(0,10),instant=/^\d{4}-\d{2}-\d{2}$/.test(day)?day+'T12:00:00Z':null;
+    const uid=resolveAuditorUid(versionIndex,e,instant);if(uid)return uid;
+   }
+   return uidByEmail.get(e)||'';
+  }
+ };
+}
+
+/** Maps one legacy log row to a Firestore realized-audit document. */
+export function realizedDocumentFromLogRow20(headers,row,auditorIndex,{source='SHEETS_BACKFILL'}={}){
+ const {cols,scopes,mapped}=indexHeaders(headers||[]);
+ const at=field=>cols[field]>=0?row[cols[field]]:'';
+ const auditId=clean(at('auditId'));
+ if(!auditId)return {issue:'MISSING_AUDIT_ID'};
+ if(!validId(auditId))return {issue:'AUDIT_ID_INVALID'};
+ const status=clean(at('status'))||'Completed';
+ if(key(status)!=='completed'&&key(status)!=='realized')return {issue:'NOT_COMPLETED',auditId};
+ const dateCompleted=isoDate(at('dateCompleted')),loggedUid=clean(at('auditorUid')),email=clean(at('auditorEmail'));
+ const resolved=email?auditorIndex.uidForEmail(email,dateCompleted||null):'';
+ if(loggedUid&&!auditorIndex.hasUid(loggedUid))return {issue:'AUDITOR_UID_UNKNOWN',auditId};
+ if(loggedUid&&resolved&&resolved!==loggedUid)return {issue:'AUDITOR_UID_EMAIL_CONFLICT',auditId};
+ const auditorUid=loggedUid||resolved;
+ if(!auditorUid)return {issue:'AUDITOR_UNRESOLVED',auditId};
+ const completedBy=clean(at('completedByEmail')).toLowerCase();
+ const extra={};
+ (headers||[]).forEach((h,i)=>{const name=clean(h),v=row[i];if(!name||mapped.has(i)||v===''||v===null||v===undefined)return;extra[name]=typeof v==='number'||typeof v==='boolean'?v:clean(v);});
+ const year=parseInt(clean(at('year')),10);
+ const document={
+  schema:REALIZED_AUDIT_SCHEMA_20,auditId,status:'Completed',auditorUid,
+  companyUid:clean(at('companyUid')),company:clean(at('company')),location:clean(at('location')),
+  year:Number.isFinite(year)?year:null,
+  datePlanned:isoDate(at('datePlanned')),dateApproved:isoDate(at('dateApproved')),
+  dateAccepted:isoDate(at('dateAccepted')),dateCompleted,
+  hoursPlanned:hours(at('hoursPlanned')),hoursDedicated:hours(at('hoursDedicated')),hoursToBePlanned:hours(at('hoursToBePlanned')),
+  scopeSlotKeys:scopes.filter(s=>s.i>=0&&yes(row[s.i])).map(s=>s.slot),
+  scopesList:clean(at('scopesList')),
+  completedByUid:completedBy?auditorIndex.uidForEmail(completedBy)||null:null,
+  completedByEmail:completedBy||null,
+  extra,source
+ };
+ return {document};
+}
+
+/** Dry-run backfill plan. Returns documents plus PII-free counters only. */
+export function planRealizedAuditsBackfill20({logValues,auditorValues,identityVersions=null,existingIds=[]}={}){
+ if(!Array.isArray(logValues)||!Array.isArray(logValues[0]))throw Error('REALIZED_LOG_SCHEMA_MISSING');
+ const index=realizedAuditorIndex20(auditorValues,identityVersions),headers=logValues[0];
+ const existing=new Set(existingIds),seen=new Map(),issues={},documents=[];
+ let rowsRead=0,alreadyPresent=0;
+ const bump=code=>{issues[code]=(issues[code]||0)+1;};
+ for(const row of logValues.slice(1)){
+  if(!Array.isArray(row)||!row.some(v=>clean(v)))continue;
+  rowsRead++;
+  const mapped=realizedDocumentFromLogRow20(headers,row,index);
+  if(mapped.issue){if(mapped.issue!=='NOT_COMPLETED')bump(mapped.issue);else bump('NOT_COMPLETED_SKIPPED');continue;}
+  const id=mapped.document.auditId;
+  if(seen.has(id)){bump('DUPLICATE_AUDIT_ID');seen.set(id,null);continue;}
+  seen.set(id,mapped.document);
+ }
+ for(const [id,document] of seen){
+  if(!document)continue;
+  if(existing.has(id)){alreadyPresent++;continue;}
+  documents.push(document);
+ }
+ const blocking=Object.entries(issues).filter(([code])=>code!=='NOT_COMPLETED_SKIPPED').reduce((n,[,c])=>n+c,0);
+ return {dryRun:true,rowsRead,toCreate:documents.length,alreadyPresent,issues,blockingIssues:blocking,identityVersions:index.versionsStatus,
+  ready:blocking===0,digest:createHash('sha256').update(JSON.stringify(documents)).digest('hex'),documents};
+}
+
+const PROJECTION_HEADERS=['Audit ID','Company','Location','Company_UID','Auditor','Auditor_UID','Status','Year',
+ 'Date planned','Date accepted','Date completed','Date approved',...SCOPE_SLOTS,
+ 'Hours planned','Hours dedicated','Hours to be planned','Scopes list','Manager_Email'];
+
+/** Derived Sheets-shaped view used by existing readers (rotation, interval, archive). */
+export function logRowsFromRealizedDocuments20(documents,auditorValues){
+ const index=realizedAuditorIndex20(auditorValues);
+ const docs=(documents||[]).filter(d=>d&&d.schema===REALIZED_AUDIT_SCHEMA_20&&clean(d.auditId));
+ const extraNames=[...new Set(docs.flatMap(d=>Object.keys(d.extra||{})))].filter(n=>!PROJECTION_HEADERS.some(h=>key(h)===key(n))).sort();
+ const headers=[...PROJECTION_HEADERS,...extraNames];
+ const num=v=>Number.isFinite(v)?v:'';
